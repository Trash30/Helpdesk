// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum KbStatus {
  DRAFT
  PUBLISHED
}

enum MatchNoteStatus {
  VERT
  ORANGE
  ROUGE
}

enum BmcDivision {
  TOP14
  PRO_D2
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Role {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  isSystem      Boolean  @default(false)
  permissions   String[]
  roleUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users User[]
}

model User {
  id                  String    @id @default(uuid())
  firstName           String
  lastName            String
  email               String    @unique
  password            String
  roleId              String
  role                Role      @relation(fields: [roleId], references: [id])
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sportCompetitions   String[]  @default([])

  matchAttachments   MatchAttachment[]
  matchNotes         MatchNote[]       @relation("MatchNoteAuthor")
  matchNotesChaperon MatchNote[]       @relation("MatchNoteChaperon")
  kbArticles         KbArticle[]       @relation("KbAuthor")
  kbAttachments      KbAttachment[]    @relation("KbAttachmentUploader")
  commercialEvents   CommercialEvent[]
  bmcCards           BmcCard[]
  matchReports       MatchReport[]      @relation("MatchReportAuthor")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  color       String
  icon        String
  description String?
  isActive    Boolean  @default(true)
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kbArticles KbArticle[]
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model MatchAttachment {
  id           String   @id @default(uuid())
  matchKey     String   // cle composite : "{competition}_{homeTeam}_{awayTeam}_{date}"
  matchDate    DateTime // date du match (pour la purge H+6)
  filename     String   // nom genere sur disque (UUID + .pdf)
  originalName String   // nom original du fichier uploade
  size         Int      // taille en bytes
  path         String   // chemin disque relatif
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model MatchNote {
  id           String   @id @default(uuid())
  matchKey     String   @unique // "{competition}_{homeTeam}_{awayTeam}_{date}" — même format que MatchAttachment
  content      String   // HTML Tiptap
  matchDate    DateTime // pour le tri chronologique dans le rapport
  competition  String   // ex: "TOP14", "LIGUE1", etc.
  homeTeam     String
  awayTeam     String
  discipline   String?  // ex: SX, SXT, SBX, BXT, PGS, PSL, GS, PRT, MO, AE (compétitions FIS uniquement)
  gender       String?  // "M" ou "W" (compétitions FIS uniquement)
  matchTime    String   // "HH:mm"
  venue        String?
  homeTeamLogo String?
  awayTeamLogo String?
  broadcasterLogo String?
  status       MatchNoteStatus @default(VERT)
  production              String?   // "BeIN" | "Via Storia" | "AMP Visual" | "IXI Live"
  chaperonnage            Boolean   @default(false)
  chaperonneTechnicienId  String?
  chaperonneTechnicien    User?     @relation("MatchNoteChaperon", fields: [chaperonneTechnicienId], references: [id])
  authorId     String
  author       User     @relation("MatchNoteAuthor", fields: [authorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KbArticle {
  id             String      @id @default(uuid())
  title          String
  content        String      // HTML riche (TipTap)
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id])
  tags           String[]
  status         KbStatus    @default(DRAFT)
  authorId       String
  author         User        @relation("KbAuthor", fields: [authorId], references: [id])
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  attachments    KbAttachment[]
}

model KbAttachment {
  id           String    @id @default(uuid())
  articleId    String
  article      KbArticle @relation(fields: [articleId], references: [id])
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  uploadedById String
  uploadedBy   User      @relation("KbAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
}

model CommercialEvent {
  id                   String   @id @default(uuid())
  clientName           String
  startDate            DateTime
  endDate              DateTime
  location             String
  techContactFirstName String
  techContactLastName  String
  techContactEmail     String
  techContactPhone     String
  competition          String
  notes                String
  createdById          String
  createdBy            User     @relation(fields: [createdById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BmcCard {
  id          String      @id @default(uuid())
  name        String
  ip          String
  division    BmcDivision
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([ip])
}


model MatchReport {
  id          String   @id @default(uuid())
  year        Int
  weekNumber  Int
  startOfWeek DateTime
  endOfWeek   DateTime
  noteCount   Int
  filename    String
  size        Int
  data        Bytes    // fichier .docx tel que généré (images incluses)
  createdById String
  createdBy   User     @relation("MatchReportAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([year, weekNumber])
}
